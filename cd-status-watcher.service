[Unit]
Description=CD Player status watcher for Snapclient
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cd-status-watcher.sh
Restart=always
RestartSec=5
User=root
# Log stdout/stderr to the journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

