[Unit]
Description=Clear Display and Turn Off LED at Shutdown
DefaultDependencies=no
After=shutdown.target
Before=final.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Command to clear your display (replace with your actual clearing script/binary)
ExecStart=/usr/sbin/i2ctransfer -y -f 1 w4@0x3c 0x00 0xae 0x8d 0x10
# Command to turn off the red power LED
# ExecStart=/bin/sh -c 'echo 0 > /sys/class/leds/PWR/brightness 2>/dev/null || echo 0 > /sys/class/leds/led1/brightness'

[Install]
WantedBy=shutdown.target
